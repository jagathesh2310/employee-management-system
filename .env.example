APP_NAME="Employee Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------
# Database – PostgreSQL (via Laravel Sail)
# -------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=employee_management
DB_USERNAME=sail
DB_PASSWORD=password

# -------------------------------------------------
# Session
# -------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------
# Broadcasting / Filesystem
# -------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -------------------------------------------------
# Queue – Redis (queue workers managed by Supervisor)
# -------------------------------------------------
QUEUE_CONNECTION=redis

# -------------------------------------------------
# Cache – Redis
# -------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=ems_

# -------------------------------------------------
# Redis
# -------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------
# Mail – Mailpit (local SMTP catcher)
# -------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ems.local"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------
# Sanctum – API token authentication
# -------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost

# -------------------------------------------------
# Vite
# -------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------
# Sail port overrides (optional)
# -------------------------------------------------
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
